{
  "name": "@ucolis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "seed:superadmin": "tsx --env-file=.env src/scripts/seedSuperAdmin.ts",
    "seed:content": "tsx --env-file=.env src/scripts/seedContent.ts"
  },
  "dependencies": {
    "@sentry/node": "^9.40.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@ucolis/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limiter-flexible": "^7.3.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
